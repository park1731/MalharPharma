# malharcare.in: Apache settings for the website
# (Used by Apache hosts such as Hostinger. Other hosts ignore this file.)

# ---------- One address for the site: https://malharcare.in ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.malharcare.in -> malharcare.in
  RewriteCond %{HTTP_HOST} ^www\.malharcare\.in$ [NC]
  RewriteRule ^(.*)$ https://malharcare.in/$1 [L,R=301]

  # http -> https. Left switched off, as it was before. Remove the three "#"
  # below only after checking that https://malharcare.in opens correctly,
  # or use your host's "Force HTTPS" setting instead.
  # RewriteCond %{HTTPS} off
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^(.*)$ https://malharcare.in/$1 [L,R=301]

  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]

  # Keep working files private: hidden files, the tools folder, notes
  RewriteRule (^|/)\.(?!well-known/) - [F]
  RewriteRule ^(tools|node_modules)(/|$) - [F]
  RewriteRule \.(md|log|bak|sh)$ - [F,NC]
</IfModule>

ErrorDocument 404 /404.html

# ---------- File types ----------
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddCharset utf-8 .html .css .js .xml .txt .webmanifest .svg
</IfModule>

# ---------- Security ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Everything the site needs is served from this domain. The only outside
  # content is the Google map, which loads as a visitor scrolls near it.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# ---------- Caching ----------
<IfModule mod_headers.c>
  # The page, styles and script are checked on every visit, so anything you
  # upload shows up straight away.
  <FilesMatch "\.(html|css|js|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Photos and icons are kept for a week.
  <FilesMatch "\.(avif|webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Fonts never change.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---------- Compression ----------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml text/javascript application/javascript application/json application/manifest+json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/manifest+json application/xml image/svg+xml
</IfModule>
